{
  "name": "markdown-visualiser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.js",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:e2e": "bash tests/e2e/run.sh",
    "test:security": "bash tests/e2e/run.sh adversarial"
  },
  "//dependencies": "Runtime-only. The Docker runtime stage installs exactly these with --omit=dev; everything the browser needs is bundled into dist/ by Vite and therefore lives in devDependencies.",
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "p-limit": "^7.1.0",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@fontsource/fraunces": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/newsreader": "^5.2.5",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.10",
    "eslint": "^9.37.0",
    "github-slugger": "^2.0.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-string": "^3.0.1",
    "jsdom": "^27.0.0",
    "katex": "^0.16.22",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^1.3.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1",
    "zustand": "^5.0.8"
  }
}
